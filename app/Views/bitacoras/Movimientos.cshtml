@model MovimientosViewModel
@{
    ViewData["Title"] = "Bitácora de movimientos de usuario";
    var filtro = Model.Filtro;
}
<div class="card">
    <form method="get" asp-action="Movimientos" class="filtros">
        <div class="field">
            <label for="IdUsuario">Usuario</label>
            <select id="IdUsuario" name="IdUsuario">
                <option value="">Todos</option>
                @foreach (var opcion in (SelectList)ViewBag.Usuarios) { <option value="@opcion.Value" selected="@opcion.Selected">@opcion.Text</option> }
            </select>
        </div>
        <div class="field">
            <label for="TipoMovimiento">Tipo de movimiento</label>
            <select id="TipoMovimiento" name="TipoMovimiento">
                <option value="">Todos</option>
                @foreach (var opcion in (SelectList)ViewBag.Tipos) { <option value="@opcion.Value" selected="@opcion.Selected">@opcion.Text</option> }
            </select>
        </div>
        <div class="field">
            <label for="Modulo">Módulo</label>
            <select id="Modulo" name="Modulo">
                <option value="">Todos</option>
                @foreach (var opcion in (SelectList)ViewBag.Modulos) { <option value="@opcion.Value" selected="@opcion.Selected">@opcion.Text</option> }
            </select>
        </div>
        <div class="field">
            <label for="Desde">Desde</label>
            <input type="date" id="Desde" name="Desde" value="@filtro.Desde?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label for="Hasta">Hasta</label>
            <input type="date" id="Hasta" name="Hasta" value="@filtro.Hasta?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-actions">
            <button type="submit" name="consultar" value="1" class="btn primary">Consultar</button>
            <a asp-action="Movimientos" class="btn">Limpiar filtros</a>
        </div>
    </form>
</div>

@if (!Model.Filas.Any())
{
    <p class="muted">No se encontraron registros con esos criterios.</p>
}
else
{
    <div class="card"><div class="table-wrap">
        <table class="grid">
            <thead><tr><th>Id</th><th>Dirección IP</th><th>Usuario</th><th>Fecha y hora</th><th>Módulo</th><th>Tipo de movimiento</th><th>Detalle</th></tr></thead>
            <tbody>
            @foreach (var movimiento in Model.Filas)
            {
                <tr>
                    <td>@movimiento.Id</td>
                    <td>@movimiento.Ip</td>
                    <td>@movimiento.Nombre <span class="muted">(@movimiento.Usuario)</span></td>
                    <td>@movimiento.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>@movimiento.Modulo</td>
                    <td>@movimiento.Tipo</td>
                    <td>@movimiento.Detalle</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Paginacion" model="Model.Paginacion" />
    </div>
}
