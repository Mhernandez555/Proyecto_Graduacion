@model IngresosViewModel
@{
    ViewData["Title"] = "Bitácora de ingreso de usuarios";
    var filtro = Model.Filtro;
}
<div class="card">
    <form method="get" asp-action="Ingresos" class="filtros">
        <div class="field">
            <label for="IdUsuario">Usuario</label>
            <select id="IdUsuario" name="IdUsuario">
                <option value="">Todos</option>
                @foreach (var opcion in (SelectList)ViewBag.Usuarios) { <option value="@opcion.Value" selected="@opcion.Selected">@opcion.Text</option> }
            </select>
        </div>
        <div class="field">
            <label for="Desde">Desde</label>
            <input type="date" id="Desde" name="Desde" value="@filtro.Desde?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label for="Hasta">Hasta</label>
            <input type="date" id="Hasta" name="Hasta" value="@filtro.Hasta?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-actions">
            <button type="submit" name="consultar" value="1" class="btn primary">Consultar</button>
            <a asp-action="Ingresos" class="btn">Limpiar filtros</a>
        </div>
    </form>
</div>

@if (!Model.Filas.Any())
{
    <p class="muted">No se encontraron registros con esos criterios.</p>
}
else
{
    <div class="card"><div class="table-wrap">
        <table class="grid">
            <thead><tr><th>Id</th><th>Dirección IP</th><th>Usuario</th><th>Nombre</th><th>Entrada</th><th>Salida</th><th>Motivo de salida</th></tr></thead>
            <tbody>
            @foreach (var ingreso in Model.Filas)
            {
                <tr>
                    <td>@ingreso.Id</td>
                    <td>@ingreso.Ip</td>
                    <td>@ingreso.Usuario</td>
                    <td>@ingreso.Nombre</td>
                    <td>@ingreso.Entrada.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>
                        @if (ingreso.Salida is DateTime fechaSalida) { @fechaSalida.ToString("dd/MM/yyyy HH:mm:ss") }
                        else { <span class="pill info">Sesión activa</span> }
                    </td>
                    <td>@(ingreso.MotivoSalida ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Paginacion" model="Model.Paginacion" />
    </div>
    <p class="muted">Si una sesión se cierra por inactividad, su hora de salida es la de su última actividad más @Controlex.Web.Services.SesionConfig.MinutosInactividad minutos.</p>
}
