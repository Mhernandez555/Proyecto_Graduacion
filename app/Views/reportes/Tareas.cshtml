@model TareasReporteViewModel
@{
    ViewData["Title"] = "Reporte de eficiencia de tareas y pendientes";
    var f = Model.Filtro;
    var eficiencia = f.Tipo != "pendientes";
}
<div class="card">
    <form method="get" asp-action="Tareas" class="filtros">
        <div class="field">
            <label for="Tipo">Tipo de reporte</label>
            <select id="Tipo" name="Tipo">
                <option value="eficiencia" selected="@eficiencia">Eficiencia de tareas</option>
                <option value="pendientes" selected="@(!eficiencia)">Tareas pendientes</option>
            </select>
        </div>
        <div class="field">
            <label for="IdProyecto">Proyecto</label>
            <select id="IdProyecto" name="IdProyecto">
                <option value="">Todos</option>
                @foreach (var o in (SelectList)ViewBag.Proyectos) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
            </select>
        </div>
        @if (!Model.SoloPropias)
        {
            <div class="field">
                <label for="IdUsuario">Usuario asignado</label>
                <select id="IdUsuario" name="IdUsuario">
                    <option value="">Todos</option>
                    @foreach (var o in (SelectList)ViewBag.Usuarios) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
                </select>
            </div>
        }
        <div class="field">
            <label for="IdEstado">Estado</label>
            <select id="IdEstado" name="IdEstado">
                <option value="">Todos</option>
                @foreach (var o in (SelectList)ViewBag.Estados) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
            </select>
        </div>
        <div class="field">
            <label for="Desde">Período desde</label>
            <input type="date" id="Desde" name="Desde" value="@f.Desde?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label for="Hasta">Período hasta</label>
            <input type="date" id="Hasta" name="Hasta" value="@f.Hasta?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-actions">
            <button type="submit" name="consultar" value="1" class="btn primary">Consultar</button>
            <button type="submit" formaction="@Url.Action("TareasPdf")" formtarget="_blank" class="btn">Exportar PDF</button>
        </div>
    </form>
    @if (Model.SoloPropias) { <p class="muted">Se muestran únicamente las tareas asignadas a usted.</p> }
</div>

@if (!Model.Consultado)
{
    <p class="muted">Seleccione los criterios y presione Consultar.</p>
}
else if (!Model.Filas.Any())
{
    <p class="muted">No se encontraron tareas con esos criterios.</p>
}
else
{
    var est = Model.Filas.Sum(x => x.Estimado);
    var reg = Model.Filas.Sum(x => x.Registrado);
    var conTiempo = Model.Filas.Where(x => x.Registrado > 0).ToList();
    var regCon = conTiempo.Sum(x => x.Registrado);
    <div class="card"><div class="table-wrap">
        <table class="grid">
            <thead><tr>
                <th>Código</th><th>Tarea</th><th>Proyecto</th><th>Categoría</th><th>Asignados</th><th>Estado</th><th>Inicio</th><th>Fin</th>
                <th class="num">Estimado (h)</th><th class="num">Registrado (h)</th>
                @if (eficiencia) { <th class="num">Diferencia (h)</th><th class="num">Eficiencia</th> }
                else { <th>Situación</th> }
            </tr></thead>
            <tbody>
            @foreach (var x in Model.Filas)
            {
                <tr>
                    <td>@x.Codigo</td>
                    <td>@x.Nombre</td>
                    <td>@x.Proyecto</td>
                    <td>@x.Categoria</td>
                    <td>@x.Usuarios</td>
                    <td><span class="pill @Formato.ClaseEstado(x.Estado)">@x.Estado</span></td>
                    <td>@Formato.Fecha(x.FechaInicio)</td>
                    <td>@Formato.Fecha(x.FechaFin)</td>
                    <td class="num">@Formato.Horas(x.Estimado)</td>
                    <td class="num">@Formato.Horas(x.Registrado)</td>
                    @if (eficiencia)
                    {
                        <td class="num @(x.Diferencia < 0 ? "neg" : "")">@Formato.Horas(x.Diferencia)</td>
                        <td class="num">@Formato.Porcentaje(x.Eficiencia)</td>
                    }
                    else
                    {
                        <td>
                            @if (x.Vencida) { <span class="pill bad">Vencida</span> }
                            else { <span class="pill ok">En plazo</span> }
                        </td>
                    }
                </tr>
            }
            </tbody>
            <tfoot><tr>
                <th colspan="8">Totales (@Model.Filas.Count tareas)</th>
                <th class="num">@Formato.Horas(est)</th>
                <th class="num">@Formato.Horas(reg)</th>
                @if (eficiencia)
                {
                    <th class="num">@Formato.Horas(est - reg)</th>
                    <th class="num">@(regCon > 0 ? Formato.Porcentaje(conTiempo.Sum(x => x.Estimado) / regCon) : "—")</th>
                }
                else { <th></th> }
            </tr></tfoot>
        </table>
    </div></div>
    @if (eficiencia)
    {
        <p class="muted">Eficiencia = horas estimadas ÷ horas registradas. 100 % o más: dentro de lo estimado. Las tareas sin horas registradas no se incluyen en el total de eficiencia.</p>
    }
    else
    {
        <p class="muted">Pendientes: tareas que no están completadas. Vencida: la fecha de finalización ya pasó.</p>
    }
}
