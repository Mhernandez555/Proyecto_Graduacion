@model TareasReporteViewModel
@{
    ViewData["Title"] = "Reporte de eficiencia de tareas y pendientes";
    var filtro = Model.Filtro;
    var eficiencia = filtro.Tipo != "pendientes";
}
<div class="card">
    <form method="get" asp-action="Tareas" class="filtros">
        <div class="field">
            <label for="Tipo">Tipo de reporte</label>
            <select id="Tipo" name="Tipo">
                <option value="eficiencia" selected="@eficiencia">Eficiencia de tareas</option>
                <option value="pendientes" selected="@(!eficiencia)">Tareas pendientes</option>
            </select>
        </div>
        <div class="field">
            <label for="IdProyecto">Proyecto</label>
            <select id="IdProyecto" name="IdProyecto">
                <option value="">Todos</option>
                @foreach (var opcion in (SelectList)ViewBag.Proyectos) { <option value="@opcion.Value" selected="@opcion.Selected">@opcion.Text</option> }
            </select>
        </div>
        @if (!Model.SoloPropias)
        {
            <div class="field">
                <label for="IdUsuario">Usuario asignado</label>
                <select id="IdUsuario" name="IdUsuario">
                    <option value="">Todos</option>
                    @foreach (var opcion in (SelectList)ViewBag.Usuarios) { <option value="@opcion.Value" selected="@opcion.Selected">@opcion.Text</option> }
                </select>
            </div>
        }
        <div class="field">
            <label for="IdEstado">Estado</label>
            <select id="IdEstado" name="IdEstado">
                <option value="">Todos</option>
                @foreach (var opcion in (SelectList)ViewBag.Estados) { <option value="@opcion.Value" selected="@opcion.Selected">@opcion.Text</option> }
            </select>
        </div>
        <div class="field">
            <label for="Desde">Período desde</label>
            <input type="date" id="Desde" name="Desde" value="@filtro.Desde?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label for="Hasta">Período hasta</label>
            <input type="date" id="Hasta" name="Hasta" value="@filtro.Hasta?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-actions">
            <button type="submit" name="consultar" value="1" class="btn primary">Consultar</button>
            <button type="submit" formaction="@Url.Action("TareasPdf")" formtarget="_blank" class="btn">Exportar PDF</button>
        </div>
    </form>
    @if (Model.SoloPropias) { <p class="muted">Se muestran únicamente las tareas asignadas a usted.</p> }
</div>

@if (!Model.Consultado)
{
    <p class="muted">Seleccione los criterios y presione Consultar.</p>
}
else if (!Model.Filas.Any())
{
    <p class="muted">No se encontraron tareas con esos criterios.</p>
}
else
{
    var totalEstimado = Model.Resumen.Estimado;
    var totalRegistrado = Model.Resumen.Registrado;
    var horasEstimadasConTiempo = Model.Resumen.EstimadoConTiempo;
    var horasRegistradasConTiempo = Model.Resumen.RegistradoConTiempo;
    <div class="card"><div class="table-wrap">
        <table class="grid">
            <thead><tr>
                <th>Código</th><th>Tarea</th><th>Proyecto</th><th>Categoría</th><th>Asignados</th><th>Estado</th><th>Inicio</th><th>Fin</th>
                <th class="num">Estimado (h)</th><th class="num">Registrado (h)</th>
                @if (eficiencia) { <th class="num">Diferencia (h)</th><th class="num">Eficiencia</th> }
                else { <th>Situación</th> }
            </tr></thead>
            <tbody>
            @foreach (var fila in Model.Filas)
            {
                <tr>
                    <td>@fila.Codigo</td>
                    <td>@fila.Nombre</td>
                    <td>@fila.Proyecto</td>
                    <td>@fila.Categoria</td>
                    <td>@fila.Usuarios</td>
                    <td><span class="pill @Formato.ClaseEstado(fila.Estado)">@fila.Estado</span></td>
                    <td>@Formato.Fecha(fila.FechaInicio)</td>
                    <td>@Formato.Fecha(fila.FechaFin)</td>
                    <td class="num">@Formato.Horas(fila.Estimado)</td>
                    <td class="num">@Formato.Horas(fila.Registrado)</td>
                    @if (eficiencia)
                    {
                        <td class="num @(fila.Diferencia < 0 ? "neg" : "")">@Formato.Horas(fila.Diferencia)</td>
                        <td class="num">@Formato.Porcentaje(fila.Eficiencia)</td>
                    }
                    else
                    {
                        <td>
                            @if (fila.Vencida) { <span class="pill bad">Vencida</span> }
                            else { <span class="pill ok">En plazo</span> }
                        </td>
                    }
                </tr>
            }
            </tbody>
            <tfoot><tr>
                <th colspan="8">Totales (@Model.Resumen.Cantidad tareas)</th>
                <th class="num">@Formato.Horas(totalEstimado)</th>
                <th class="num">@Formato.Horas(totalRegistrado)</th>
                @if (eficiencia)
                {
                    <th class="num">@Formato.Horas(totalEstimado - totalRegistrado)</th>
                    <th class="num">@(horasRegistradasConTiempo > 0
                        ? Formato.Porcentaje(horasEstimadasConTiempo / horasRegistradasConTiempo) : "—")</th>
                }
                else { <th></th> }
            </tr></tfoot>
        </table>
    </div>
    <partial name="_Paginacion" model="Model.Paginacion" />
    </div>
    @if (eficiencia)
    {
        <p class="muted">Eficiencia = horas estimadas ÷ horas registradas. 100 % o más: dentro de lo estimado. Las tareas sin horas registradas no se incluyen en el total de eficiencia.</p>
    }
    else
    {
        <p class="muted">Pendientes: tareas que no están completadas. Vencida: la fecha de finalización ya pasó.</p>
    }
}
