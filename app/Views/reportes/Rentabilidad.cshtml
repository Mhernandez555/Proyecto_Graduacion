@model RentabilidadViewModel
@{
    ViewData["Title"] = "Reporte de proyectos y rentabilidad";
    var f = Model.Filtro;
}
<div class="card">
    <form method="get" asp-action="Rentabilidad" class="filtros">
        <div class="field">
            <label for="IdProyecto">Proyecto</label>
            <select id="IdProyecto" name="IdProyecto">
                <option value="">Todos</option>
                @foreach (var o in (SelectList)ViewBag.Proyectos) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
            </select>
        </div>
        <div class="field">
            <label for="Desde">Inicio desde</label>
            <input type="date" id="Desde" name="Desde" value="@f.Desde?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label for="Hasta">Inicio hasta</label>
            <input type="date" id="Hasta" name="Hasta" value="@f.Hasta?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-actions">
            <button type="submit" name="consultar" value="1" class="btn primary">Consultar</button>
            <button type="submit" formaction="@Url.Action("RentabilidadPdf")" formtarget="_blank" class="btn">Exportar PDF</button>
        </div>
    </form>
</div>

@if (!Model.Consultado)
{
    <p class="muted">Seleccione los criterios y presione Consultar.</p>
}
else if (!Model.Filas.Any())
{
    <p class="muted">No se encontraron proyectos con esos criterios.</p>
}
else
{
    var venta = Model.Filas.Sum(x => x.PrecioVenta);
    var costo = Model.Filas.Sum(x => x.Costo);
    var rent = Model.Filas.Sum(x => x.Rentabilidad);
    <div class="card"><div class="table-wrap">
        <table class="grid">
            <thead><tr>
                <th>Código</th><th>Proyecto</th><th>Cliente</th><th>Estado</th><th>Inicio</th><th>Fin</th>
                <th class="num">Precio de venta</th><th class="num">Costo</th><th class="num">Rentabilidad</th><th class="num">Margen</th>
            </tr></thead>
            <tbody>
            @foreach (var x in Model.Filas)
            {
                <tr>
                    <td>@x.Codigo</td>
                    <td>@x.Proyecto</td>
                    <td>@x.Cliente</td>
                    <td><span class="pill @Formato.ClaseEstado(x.Estado)">@x.Estado</span></td>
                    <td>@Formato.Fecha(x.FechaInicio)</td>
                    <td>@Formato.Fecha(x.FechaFin)</td>
                    <td class="num">@Formato.Dinero(x.PrecioVenta)</td>
                    <td class="num">@Formato.Dinero(x.Costo)</td>
                    <td class="num @(x.Rentabilidad < 0 ? "neg" : "")">@Formato.Dinero(x.Rentabilidad)</td>
                    <td class="num">@Formato.Porcentaje(x.Margen)</td>
                </tr>
            }
            </tbody>
            <tfoot><tr>
                <th colspan="6">Totales (@Model.Filas.Count proyectos)</th>
                <th class="num">@Formato.Dinero(venta)</th>
                <th class="num">@Formato.Dinero(costo)</th>
                <th class="num @(rent < 0 ? "neg" : "")">@Formato.Dinero(rent)</th>
                <th class="num">@(venta > 0 ? Formato.Porcentaje(rent / venta) : "—")</th>
            </tr></tfoot>
        </table>
    </div></div>
    <p class="muted">Costo = horas registradas × costo por hora vigente al registrar. Rentabilidad = precio de venta − costo.</p>
}
