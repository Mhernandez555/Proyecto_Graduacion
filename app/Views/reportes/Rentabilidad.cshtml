@model RentabilidadViewModel
@{
    ViewData["Title"] = "Reporte de proyectos y rentabilidad";
    var filtro = Model.Filtro;
}
<div class="card">
    <form method="get" asp-action="Rentabilidad" class="filtros">
        <div class="field">
            <label for="IdProyecto">Proyecto</label>
            <select id="IdProyecto" name="IdProyecto">
                <option value="">Todos</option>
                @foreach (var opcion in (SelectList)ViewBag.Proyectos) { <option value="@opcion.Value" selected="@opcion.Selected">@opcion.Text</option> }
            </select>
        </div>
        <div class="field">
            <label for="Desde">Inicio desde</label>
            <input type="date" id="Desde" name="Desde" value="@filtro.Desde?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label for="Hasta">Inicio hasta</label>
            <input type="date" id="Hasta" name="Hasta" value="@filtro.Hasta?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-actions">
            <button type="submit" name="consultar" value="1" class="btn primary">Consultar</button>
            <button type="submit" formaction="@Url.Action("RentabilidadPdf")" formtarget="_blank" class="btn">Exportar PDF</button>
        </div>
    </form>
</div>

@if (!Model.Consultado)
{
    <p class="muted">Seleccione los criterios y presione Consultar.</p>
}
else if (!Model.Filas.Any())
{
    <p class="muted">No se encontraron proyectos con esos criterios.</p>
}
else
{
    var totalVentas = Model.Resumen.Ventas;
    var totalCostos = Model.Resumen.Costos;
    var rentabilidadTotal = Model.Resumen.Rentabilidad;
    <div class="card"><div class="table-wrap">
        <table class="grid">
            <thead><tr>
                <th>Código</th><th>Proyecto</th><th>Cliente</th><th>Estado</th><th>Inicio</th><th>Fin</th>
                <th class="num">Precio de venta</th><th class="num">Costo</th><th class="num">Rentabilidad</th><th class="num">Margen</th>
            </tr></thead>
            <tbody>
            @foreach (var fila in Model.Filas)
            {
                <tr>
                    <td>@fila.Codigo</td>
                    <td>@fila.Proyecto</td>
                    <td>@fila.Cliente</td>
                    <td><span class="pill @Formato.ClaseEstado(fila.Estado)">@fila.Estado</span></td>
                    <td>@Formato.Fecha(fila.FechaInicio)</td>
                    <td>@Formato.Fecha(fila.FechaFin)</td>
                    <td class="num">@Formato.Dinero(fila.PrecioVenta)</td>
                    <td class="num">@Formato.Dinero(fila.Costo)</td>
                    <td class="num @(fila.Rentabilidad < 0 ? "neg" : "")">@Formato.Dinero(fila.Rentabilidad)</td>
                    <td class="num">@Formato.Porcentaje(fila.Margen)</td>
                </tr>
            }
            </tbody>
            <tfoot><tr>
                <th colspan="6">Totales (@Model.Resumen.Cantidad proyectos)</th>
                <th class="num">@Formato.Dinero(totalVentas)</th>
                <th class="num">@Formato.Dinero(totalCostos)</th>
                <th class="num @(rentabilidadTotal < 0 ? "neg" : "")">@Formato.Dinero(rentabilidadTotal)</th>
                <th class="num">@(totalVentas > 0 ? Formato.Porcentaje(rentabilidadTotal / totalVentas) : "—")</th>
            </tr></tfoot>
        </table>
    </div>
    <partial name="_Paginacion" model="Model.Paginacion" />
    </div>
    <p class="muted">Costo = horas registradas × costo por hora vigente al registrar. Rentabilidad = precio de venta − costo.</p>
}
