@model UsuariosIndexViewModel
@{ ViewData["Title"] = "Mantenimiento de usuarios"; }
<div class="page-head">
    <p>Usuarios con acceso al sistema.</p>
    <a class="btn primary" asp-action="Crear">Nuevo usuario</a>
</div>
<div class="card"><div class="table-wrap">
    <table class="grid">
        <thead><tr><th>Cédula</th><th>Nombre</th><th>Usuario</th><th>Rol</th><th>Correo</th><th>Costo/hora</th><th>Estado</th><th>Acciones</th></tr></thead>
        <tbody>
        @foreach (var usuario in Model.Filas)
        {
            <tr>
                <td>@usuario.Cedula</td>
                <td>@usuario.Nombre @usuario.Apellido1 @usuario.Apellido2</td>
                <td>@usuario.NombreUsuario</td>
                <td>@usuario.Rol.NombreRol</td>
                <td>@usuario.Correo</td>
                <td>₡@usuario.CostoHora.ToString("N2")</td>
                <td><span class="pill @(usuario.Estado ? "ok" : "off")">@(usuario.Estado ? "Activo" : "Inactivo")</span></td>
                <td class="acciones">
                    <a class="btn small" asp-action="Editar" asp-route-id="@usuario.IdUsuario">Editar</a>
                    <form asp-action="CambiarEstado" asp-route-id="@usuario.IdUsuario" method="post">
                        <button type="submit" class="btn small">@(usuario.Estado ? "Inhabilitar" : "Habilitar")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Filas.Any()) { <p class="muted">No hay usuarios registrados.</p> }
</div>
<partial name="_Paginacion" model="Model.Paginacion" />
</div>
