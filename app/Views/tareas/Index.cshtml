@model TareasIndexViewModel
@{ ViewData["Title"] = "Tareas"; }
<div class="page-head">
    <p>@(Model.Total ? "Tareas de todos los proyectos." : "Tareas que tiene asignadas.")</p>
    @if (Model.Total) { <a class="btn primary" asp-action="Crear">Nueva tarea</a> }
</div>

<div class="card">
    <form method="get" asp-action="Index" class="filtros">
        <div class="field">
            <label for="idProyecto">Proyecto</label>
            <select id="idProyecto" name="idProyecto">
                <option value="">Todos</option>
                @foreach (var opcion in (SelectList)ViewBag.Proyectos) { <option value="@opcion.Value" selected="@opcion.Selected">@opcion.Text</option> }
            </select>
        </div>
        <div class="field">
            <label for="idEstado">Estado</label>
            <select id="idEstado" name="idEstado">
                <option value="">Todos</option>
                @foreach (var opcion in (SelectList)ViewBag.Estados) { <option value="@opcion.Value" selected="@opcion.Selected">@opcion.Text</option> }
            </select>
        </div>
        @if (Model.Total)
        {
            <div class="field">
                <label for="idUsuario">Usuario asignado</label>
                <select id="idUsuario" name="idUsuario">
                    <option value="">Todos</option>
                    @foreach (var opcion in (SelectList)ViewBag.Usuarios) { <option value="@opcion.Value" selected="@opcion.Selected">@opcion.Text</option> }
                </select>
            </div>
        }
        <div class="form-actions">
            <button type="submit" class="btn primary">Filtrar</button>
            <a asp-action="Index" class="btn">Limpiar filtros</a>
        </div>
    </form>
</div>

@if (!Model.Filas.Any())
{
    <p class="muted">No se encontraron tareas con esos criterios.</p>
}
else
{
    <div class="card"><div class="table-wrap">
        <table class="grid">
            <thead><tr>
                <th>Código</th><th>Tarea</th><th>Proyecto</th><th>Categoría</th><th>Asignados</th><th>Estado</th>
                <th>Inicio</th><th>Fin</th><th class="num">Estimado (h)</th><th class="num">Registrado (h)</th><th>Acciones</th>
            </tr></thead>
            <tbody>
            @foreach (var tarea in Model.Filas)
            {
                <tr>
                    <td>@tarea.Codigo</td>
                    <td>@tarea.Nombre</td>
                    <td>@tarea.Proyecto</td>
                    <td>@tarea.Categoria</td>
                    <td>@tarea.Asignados</td>
                    <td><span class="pill @Formato.ClaseEstado(tarea.Estado)">@tarea.Estado</span></td>
                    <td>@Formato.Fecha(tarea.FechaInicio)</td>
                    <td>
                        @Formato.Fecha(tarea.FechaFin)
                        @if (tarea.Vencida) { <span class="pill bad">Vencida</span> }
                    </td>
                    <td class="num">@Formato.Horas(tarea.Estimado)</td>
                    <td class="num">@Formato.Horas(tarea.Registrado)</td>
                    <td class="acciones">
                        <a class="btn small" asp-action="Detalle" asp-route-id="@tarea.IdTarea">Consultar</a>
                        @if (Model.Total) { <a class="btn small" asp-action="Editar" asp-route-id="@tarea.IdTarea">Editar</a> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
    <partial name="_Paginacion" model="Model.Paginacion" />
}
