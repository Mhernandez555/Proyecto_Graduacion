@model TareaDetalleViewModel
@{
    ViewData["Title"] = $"{Model.Codigo} · {Model.Nombre}";
    var eficiencia = Model.Registrado > 0 ? Formato.Porcentaje(Model.Estimado / Model.Registrado) : "—";
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
    var vencida = Model.Estado != "Completada" && Model.FechaFin is DateOnly ff && ff < DateOnly.FromDateTime(DateTime.Today);
}
<div class="page-head no-print">
    <a asp-action="Index" class="btn">Volver a tareas</a>
    @if (Model.PuedeEditar) { <a asp-action="Editar" asp-route-id="@Model.IdTarea" class="btn">Editar tarea</a> }
</div>

<div class="card">
    <dl class="ficha">
        <dt>Código</dt><dd>@Model.Codigo</dd>
        <dt>Tarea</dt><dd>@Model.Nombre</dd>
        <dt>Descripción</dt><dd>@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "—" : Model.Descripcion)</dd>
        <dt>Proyecto</dt><dd>@Model.Proyecto</dd>
        <dt>Categoría</dt><dd>@Model.Categoria</dd>
        <dt>Estado</dt><dd><span class="pill @Formato.ClaseEstado(Model.Estado)">@Model.Estado</span></dd>
        <dt>Inicio</dt><dd>@Formato.Fecha(Model.FechaInicio)</dd>
        <dt>Finalización</dt><dd>@Formato.Fecha(Model.FechaFin) @if (vencida) { <span class="pill bad">Vencida</span> }</dd>
        <dt>Asignados</dt><dd>@string.Join(", ", Model.Asignados.Select(a => a.Nombre))</dd>
        <dt>Tiempo estimado</dt><dd>@Formato.Horas(Model.Estimado) h</dd>
        <dt>Tiempo registrado</dt><dd>@Formato.Horas(Model.Registrado) h <span class="muted">(eficiencia: @eficiencia)</span></dd>
    </dl>
</div>

<div class="dos-col">
    <div class="card">
        <h2 class="section-title">Estado y comentarios</h2>
        <form asp-action="ActualizarEstado" asp-route-id="@Model.IdTarea" method="post">
            <div class="field">
                <label for="IdEstado">Estado</label>
                <select id="IdEstado" name="IdEstado">
                    @foreach (var o in (SelectList)ViewBag.Estados) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
                </select>
            </div>
            <div class="field">
                <label for="Comentarios">Comentarios</label>
                <textarea id="Comentarios" name="Comentarios" rows="4" maxlength="1000">@Model.Comentarios</textarea>
                <span class="hint">Al pasar a "En proceso" o "Completada" se completa la fecha de inicio o de fin si estaba vacía.</span>
            </div>
            <div class="form-actions"><button type="submit" class="btn primary">Actualizar</button></div>
        </form>
    </div>

    <div class="card">
        <h2 class="section-title">Registrar tiempo</h2>
        @if (!Model.Asignados.Any())
        {
            <p class="muted">La tarea no tiene usuarios asignados. Edite la tarea para asignarlos.</p>
        }
        else if (!Model.ElegirUsuario && !Model.EsAsignado)
        {
            <p class="muted">Solo los usuarios asignados pueden registrar tiempo.</p>
        }
        else
        {
            <form asp-action="RegistrarTiempo" asp-route-id="@Model.IdTarea" method="post">
                @if (Model.ElegirUsuario)
                {
                    <div class="field">
                        <label for="IdUsuario">Usuario</label>
                        <select id="IdUsuario" name="IdUsuario">
                            @foreach (var a in Model.Asignados)
                            {
                                <option value="@a.IdUsuario" selected="@(a.IdUsuario == Model.IdUsuarioActual)">@a.Nombre</option>
                            }
                        </select>
                    </div>
                }
                <div class="field">
                    <label for="Fecha">Fecha trabajada</label>
                    <input type="date" id="Fecha" name="Fecha" value="@hoy" max="@hoy" required />
                </div>
                <div class="field">
                    <label for="Horas">Horas</label>
                    <input type="number" id="Horas" name="Horas" step="0.25" min="0.25" max="24" required />
                    <span class="hint">Máximo 24 horas por día entre todas sus tareas.</span>
                </div>
                <div class="field">
                    <label for="Comentario">Comentario</label>
                    <input type="text" id="Comentario" name="Comentario" maxlength="500" />
                </div>
                <div class="form-actions"><button type="submit" class="btn primary">Registrar</button></div>
            </form>
        }
    </div>
</div>

<div class="card">
    <h2 class="section-title">Tiempo registrado</h2>
    @if (!Model.Registros.Any())
    {
        <p class="muted">Todavía no hay tiempo registrado en esta tarea.</p>
    }
    else
    {
        <div class="table-wrap"><table class="grid">
            <thead><tr>
                <th>Fecha</th><th>Usuario</th><th class="num">Horas</th>
                @if (Model.VerCostos) { <th class="num">Costo por hora</th><th class="num">Costo</th> }
                <th>Comentario</th><th>Acciones</th>
            </tr></thead>
            <tbody>
            @foreach (var r in Model.Registros)
            {
                <tr>
                    <td>@Formato.Fecha(r.Fecha)</td>
                    <td>@r.Usuario</td>
                    <td class="num">@Formato.Horas(r.Horas)</td>
                    @if (Model.VerCostos)
                    {
                        <td class="num">@Formato.Dinero(r.CostoHora)</td>
                        <td class="num">@Formato.Dinero(r.Costo)</td>
                    }
                    <td>@r.Comentario</td>
                    <td class="acciones">
                        @if (r.PuedeEliminar)
                        {
                            <form asp-action="EliminarRegistro" asp-route-id="@Model.IdTarea" asp-route-idRegistro="@r.IdRegistro" method="post">
                                <button type="submit" class="btn small" onclick="return confirm('¿Eliminar este registro de tiempo?')">Eliminar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
            <tfoot><tr>
                <th colspan="2">Total</th>
                <th class="num">@Formato.Horas(Model.Registrado)</th>
                @if (Model.VerCostos)
                {
                    <th></th>
                    <th class="num">@Formato.Dinero(Model.Registros.Sum(x => x.Costo))</th>
                }
                <th colspan="2"></th>
            </tr></tfoot>
        </table></div>
        <p class="muted">El costo por hora queda guardado en cada registro, por lo que no cambia si luego se modifica la tarifa del usuario.</p>
    }
</div>
