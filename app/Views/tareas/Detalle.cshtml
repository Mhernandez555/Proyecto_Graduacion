@model TareaDetalleViewModel
@{
    ViewData["Title"] = $"{Model.Codigo} · {Model.Nombre}";
}
<div class="page-head no-print">
    <a asp-action="Index" class="btn">Volver a tareas</a>
    @if (Model.PuedeEditar) { <a asp-action="Editar" asp-route-id="@Model.IdTarea" class="btn">Editar tarea</a> }
</div>

<div class="card">
    <dl class="ficha">
        <dt>Código</dt><dd>@Model.Codigo</dd>
        <dt>Tarea</dt><dd>@Model.Nombre</dd>
        <dt>Descripción</dt><dd>@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "—" : Model.Descripcion)</dd>
        <dt>Proyecto</dt><dd>@Model.Proyecto</dd>
        <dt>Categoría</dt><dd>@Model.Categoria</dd>
        <dt>Estado</dt><dd>@Model.Estado</dd>
        <dt>Inicio</dt><dd>@Formato.Fecha(Model.FechaInicio)</dd>
        <dt>Fin</dt><dd>@Formato.Fecha(Model.FechaFin)</dd>
        <dt>Tiempo estimado</dt><dd>@Formato.Horas(Model.Estimado) h</dd>
        <dt>Tiempo registrado</dt><dd>@Formato.Horas(Model.TotalRegistrado) h</dd>
        <dt>Usuarios asignados</dt>
        <dd>
            @if (Model.Asignados.Any())
            {
                @foreach (var usuario in Model.Asignados)
                {
                    <div>@usuario.Nombre — @Formato.Horas(usuario.Horas) h</div>
                }
            }
            else { <span>Sin usuarios asignados</span> }
        </dd>
    </dl>
</div>

<div class="card narrow">
    <h2 class="section-title">Actualizar estado y comentarios</h2>
    <form asp-action="ActualizarEstado" asp-route-id="@Model.IdTarea" method="post">
        <div class="field">
            <label for="idEstado">Estado</label>
            <select id="idEstado" name="idEstado" asp-items="(SelectList)ViewBag.Estados"></select>
        </div>
        <div class="field">
            <label for="comentarios">Comentarios</label>
            <textarea id="comentarios" name="comentarios" rows="3" maxlength="1000">@Model.Comentarios</textarea>
        </div>
        <div class="form-actions"><button type="submit" class="btn primary">Guardar cambios</button></div>
    </form>
</div>

<div class="card narrow">
    <h2 class="section-title">Registrar tiempo</h2>
    <form asp-action="RegistrarTiempo" asp-route-id="@Model.IdTarea" method="post">
        @if (Model.ElegirUsuario)
        {
            <div class="field">
                <label for="idUsuario">Usuario asignado</label>
                <select id="idUsuario" name="idUsuario">
                    <option value="">Seleccione un usuario...</option>
                    @foreach (var usuario in Model.Asignados)
                    {
                        <option value="@usuario.IdUsuario">@usuario.Nombre</option>
                    }
                </select>
            </div>
        }
        <div class="field">
            <label for="fecha">Fecha</label>
            <input type="date" id="fecha" name="fecha" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
        </div>
        <div class="field">
            <label for="horas">Horas</label>
            <input type="number" id="horas" name="horas" min="0.01" max="24" step="0.01" required />
        </div>
        <div class="field">
            <label for="comentario">Comentario</label>
            <textarea id="comentario" name="comentario" rows="2" maxlength="500"></textarea>
        </div>
        <div class="form-actions"><button type="submit" class="btn primary">Registrar tiempo</button></div>
    </form>
</div>

<div class="card">
    <h2 class="section-title">Registros de tiempo</h2>
    @if (!Model.Registros.Any())
    {
        <p class="muted">No hay registros de tiempo para esta tarea.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="grid">
                <thead><tr>
                    <th>Fecha</th><th>Usuario</th><th class="num">Horas</th>
                    @if (Model.VerCostos) { <th class="num">Costo</th> }
                    <th>Comentario</th><th>Acciones</th>
                </tr></thead>
                <tbody>
                @foreach (var registro in Model.Registros)
                {
                    <tr>
                        <td>@registro.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@registro.Usuario</td>
                        <td class="num">@Formato.Horas(registro.Horas)</td>
                        @if (Model.VerCostos) { <td class="num">@Formato.Dinero(registro.Costo)</td> }
                        <td>@(string.IsNullOrWhiteSpace(registro.Comentario) ? "—" : registro.Comentario)</td>
                        <td class="acciones">
                            @if (registro.PuedeEliminar)
                            {
                                <form asp-action="EliminarRegistro" asp-route-id="@Model.IdTarea"
                                      asp-route-idRegistro="@registro.IdRegistro" method="post">
                                    <button type="submit" class="btn small">Eliminar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="_Paginacion" model="Model.Paginacion" />
    }
</div>
