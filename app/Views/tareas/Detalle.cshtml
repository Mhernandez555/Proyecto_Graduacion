@model ProyectoDetalleViewModel
@functions { bool Ve(string modulo) => int.TryParse(User.FindFirst("perm:" + modulo)?.Value, out var n) && n > 0; }
@{
    ViewData["Title"] = $"{Model.Codigo} · {Model.Nombre}";
    var puedeCrearTarea = int.TryParse(User.FindFirst("perm:TAREAS")?.Value, out var nt) && nt >= 2
                          && Model.Estado is not ("Finalizado" or "Cancelado");
}
<div class="page-head no-print">
    <a asp-action="Index" class="btn">Volver a proyectos</a>
    @if (Model.PuedeEditar) { <a asp-action="Editar" asp-route-id="@Model.IdProyecto" class="btn">Editar proyecto</a> }
</div>

@if (Model.VerFinanzas)
{
    <div class="stats fin">
        <div class="stat"><strong>@Formato.Dinero(Model.Precio)</strong><span>Precio de venta</span></div>
        <div class="stat"><strong>@Formato.Dinero(Model.Costo)</strong><span>Costo acumulado</span></div>
        <div class="stat @(Model.Rentabilidad < 0 ? "bad" : "")"><strong>@Formato.Dinero(Model.Rentabilidad)</strong><span>Rentabilidad</span></div>
        <div class="stat @(Model.Margen is decimal mg && mg < 0 ? "bad" : "")"><strong>@Formato.Porcentaje(Model.Margen)</strong><span>Margen sobre el precio</span></div>
    </div>
}

<div class="card">
    <dl class="ficha">
        <dt>Código</dt><dd>@Model.Codigo</dd>
        <dt>Proyecto</dt><dd>@Model.Nombre</dd>
        <dt>Descripción</dt><dd>@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "—" : Model.Descripcion)</dd>
        <dt>Cliente</dt><dd>@Model.Cliente</dd>
        <dt>Categoría</dt><dd>@Model.Categoria</dd>
        <dt>Responsable</dt><dd>@Model.Responsable</dd>
        <dt>Estado</dt><dd><span class="pill @Formato.ClaseEstado(Model.Estado)">@Model.Estado</span></dd>
        <dt>Inicio</dt><dd>@Formato.Fecha(Model.FechaInicio)</dd>
        <dt>Finalización prevista</dt><dd>@Formato.Fecha(Model.FechaFin)</dd>
        <dt>Avance</dt><dd>@(Model.Tareas.Count == 0 ? "Sin tareas" : $"{Model.TareasCompletadas} de {Model.Tareas.Count} tareas completadas")</dd>
    </dl>
</div>

@if (Model.PuedeEditar)
{
    <div class="card narrow">
        <h2 class="section-title">Cambiar estado</h2>
        <form asp-action="CambiarEstado" asp-route-id="@Model.IdProyecto" method="post">
            <div class="field">
                <label for="IdEstado">Estado</label>
                <select id="IdEstado" name="IdEstado">
                    @foreach (var o in (SelectList)ViewBag.Estados) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
                </select>
                <span class="hint">Un proyecto solo se puede finalizar cuando todas sus tareas están completadas.</span>
            </div>
            <div class="form-actions"><button type="submit" class="btn primary">Actualizar estado</button></div>
        </form>
    </div>
}

<div class="card">
    <div class="page-head">
        <h2 class="section-title">@(Model.PuedeEditar ? "Tareas del proyecto" : "Mis tareas en el proyecto")</h2>
        @if (puedeCrearTarea) { <a asp-controller="Tareas" asp-action="Crear" asp-route-idProyecto="@Model.IdProyecto" class="btn small">Nueva tarea en este proyecto</a> }
    </div>
    @if (!Model.Tareas.Any())
    {
        <p class="muted">No hay tareas para mostrar.</p>
    }
    else
    {
        <div class="table-wrap"><table class="grid">
            <thead><tr>
                <th>Código</th><th>Tarea</th><th>Categoría</th><th>Asignados</th><th>Estado</th><th>Inicio</th><th>Fin</th>
                <th class="num">Estimado (h)</th><th class="num">Registrado (h)</th>
                @if (Ve("TAREAS")) { <th>Acciones</th> }
            </tr></thead>
            <tbody>
            @foreach (var t in Model.Tareas)
            {
                <tr>
                    <td>@t.Codigo</td>
                    <td>@t.Nombre</td>
                    <td>@t.Categoria</td>
                    <td>@t.Asignados</td>
                    <td><span class="pill @Formato.ClaseEstado(t.Estado)">@t.Estado</span></td>
                    <td>@Formato.Fecha(t.FechaInicio)</td>
                    <td>@Formato.Fecha(t.FechaFin) @if (t.Vencida) { <span class="pill bad">Vencida</span> }</td>
                    <td class="num">@Formato.Horas(t.Estimado)</td>
                    <td class="num">@Formato.Horas(t.Registrado)</td>
                    @if (Ve("TAREAS"))
                    {
                        <td class="acciones"><a class="btn small" asp-controller="Tareas" asp-action="Detalle" asp-route-id="@t.IdTarea">Consultar</a></td>
                    }
                </tr>
            }
            </tbody>
            <tfoot><tr>
                <th colspan="7">Total (@Model.Tareas.Count tareas)</th>
                <th class="num">@Formato.Horas(Model.Tareas.Sum(x => x.Estimado))</th>
                <th class="num">@Formato.Horas(Model.Tareas.Sum(x => x.Registrado))</th>
                @if (Ve("TAREAS")) { <th></th> }
            </tr></tfoot>
        </table></div>
    }
</div>
@if (Model.VerFinanzas)
{
    <p class="muted">Costo = horas registradas × costo por hora vigente al registrar. Rentabilidad = precio de venta − costo.</p>
}
