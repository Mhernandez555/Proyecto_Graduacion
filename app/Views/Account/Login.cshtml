@model LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar sesión – CONTROLEX</title>
    <script src="~/assets/js/tema.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/tema.css" asp-append-version="true" />
</head>
<body class="login-page">
<main class="login-card">
    <div class="login-tools">
        <button type="button" id="tema-toggle" class="theme-toggle" aria-label="Activar modo nocturno" aria-pressed="false">Oscuro</button>
    </div>
    <div class="brand dark"><span class="brand-mark">C</span><span>CONTROLEX</span></div>
    <h1>Iniciar sesión</h1>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert" role="alert">
            @foreach (var errorModelo in ViewData.ModelState.SelectMany(estado => estado.Value!.Errors)) { <div>@errorModelo.ErrorMessage</div> }
        </div>
    }
    <form asp-action="Login" method="post">
        <label>@Html.DisplayNameFor(modelo => modelo.NombreUsuario)
            <input asp-for="NombreUsuario" autocomplete="username" autofocus /></label>
        <label>@Html.DisplayNameFor(modelo => modelo.Contrasena)
            <input asp-for="Contrasena" type="password" autocomplete="current-password" /></label>
        <div class="actions">
            <button type="submit" class="btn primary">Iniciar sesión</button>
            <button type="reset" class="btn">Cancelar</button>
        </div>
        <a asp-controller="Recuperar" asp-action="Index" class="link">¿Olvidó su contraseña?</a>
    </form>
</main>
</body>
</html>
