@model LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar sesión – CONTROLEX</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
<main class="login-card">
    <div class="brand dark"><span class="brand-mark">C</span><span>CONTROLEX</span></div>
    <h1>Iniciar sesión</h1>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert" role="alert">
            @foreach (var e in ViewData.ModelState.SelectMany(x => x.Value!.Errors)) { <div>@e.ErrorMessage</div> }
        </div>
    }
    <form asp-action="Login" method="post">
        <label>@Html.DisplayNameFor(m => m.NombreUsuario)
            <input asp-for="NombreUsuario" autocomplete="username" autofocus /></label>
        <label>@Html.DisplayNameFor(m => m.Contrasena)
            <input asp-for="Contrasena" type="password" autocomplete="current-password" /></label>
        <div class="actions">
            <button type="submit" class="btn primary">Iniciar sesión</button>
            <button type="reset" class="btn">Cancelar</button>
        </div>
        <a href="#" class="link">Recuperar contraseña</a>
    </form>
</main>
</body>
</html>
