@model RolesIndexViewModel
@{ ViewData["Title"] = "Roles y permisos"; }
<div class="page-head">
    <p>Roles del sistema y los módulos a los que accede cada uno.</p>
    <a class="btn primary" asp-action="Crear">Nuevo rol</a>
</div>
<div class="card"><div class="table-wrap">
    <table class="grid">
        <thead><tr><th>Rol</th><th>Descripción</th><th>Acceso</th><th>Estado</th><th>Acciones</th></tr></thead>
        <tbody>
        @foreach (var rol in Model.Filas)
        {
            <tr>
                <td>@rol.NombreRol</td>
                <td>@rol.Descripcion</td>
                <td>@(rol.EsAdministrador ? "Total (administrador)" : "Según permisos")</td>
                <td><span class="pill @(rol.Estado ? "ok" : "off")">@(rol.Estado ? "Activo" : "Inactivo")</span></td>
                <td class="acciones"><a class="btn small" asp-action="Editar" asp-route-id="@rol.IdRol">Editar</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
<partial name="_Paginacion" model="Model.Paginacion" />
</div>
