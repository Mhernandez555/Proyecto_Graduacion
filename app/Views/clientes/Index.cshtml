@model ClientesIndexViewModel
@{ ViewData["Title"] = "Mantenimiento de clientes"; }
<div class="page-head">
    <p>Clientes de WallRed que se asocian a los proyectos.</p>
    <a class="btn primary" asp-action="Crear">Nuevo cliente</a>
</div>
<div class="card"><div class="table-wrap">
    <table class="grid">
        <thead><tr><th>Identificación</th><th>Cliente</th><th>Tipo</th><th>Contacto</th><th>Teléfono</th><th>Correo</th><th>Estado</th><th>Acciones</th></tr></thead>
        <tbody>
        @foreach (var cliente in Model.Filas)
        {
            <tr>
                <td>@cliente.Identificacion</td>
                <td>@cliente.NombreCliente</td>
                <td>@cliente.TipoCliente.Nombre</td>
                <td>@cliente.Contacto</td>
                <td>@cliente.Telefono1</td>
                <td>@cliente.Correo</td>
                <td><span class="pill @(cliente.Estado ? "ok" : "off")">@(cliente.Estado ? "Activo" : "Inactivo")</span></td>
                <td class="acciones">
                    <a class="btn small" asp-action="Editar" asp-route-id="@cliente.IdCliente">Editar</a>
                    <form asp-action="CambiarEstado" asp-route-id="@cliente.IdCliente" method="post">
                        <button type="submit" class="btn small">@(cliente.Estado ? "Inhabilitar" : "Habilitar")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Filas.Any()) { <p class="muted">No hay clientes registrados.</p> }
</div>
<partial name="_Paginacion" model="Model.Paginacion" />
</div>
