<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- La carpeta test/ tendrá sus propios proyectos más adelante -->
    <Compile Remove="test/**" />
    <Content Remove="test/**" />
    <None Remove="test/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Evita compilar artefactos generados por builds anteriores dentro de app/. -->
    <Compile Remove="app/obj/**;app/bin/**" />
    <Content Remove="app/obj/**;app/bin/**" />
    <None Remove="app/obj/**;app/bin/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="QuestPDF" Version="2026.6.1" />
  </ItemGroup>
</Project>
